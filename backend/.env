# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1

# Database Configuration (Prisma Connection)
DATABASE_URL="postgresql://postgres:1832@localhost:5432/recruitment_db"
DIRECT_URL="postgresql://postgres:1832@localhost:5432/recruitment_db"

# JWT Security
JWT_SECRET=ethio_recruitment_user_jwt_secret_key_32bytes_min!
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=ethio_recruitment_admin_jwt_secret_key_32bytes_min!
ADMIN_JWT_EXPIRES_IN=8h

# Media Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# Telecom Gateway (SMSEthiopia)
SMS_ETHIOPIA_API_KEY=mock_smsethiopia_api_key
SMS_ETHIOPIA_SENDER_ID=AGENCY

# Push Notifications (Expo Push API)
EXPO_ACCESS_TOKEN=mock_expo_access_token

# Observability & CORS
SENTRY_DSN=
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
