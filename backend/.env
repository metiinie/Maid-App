# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruitment_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recruitment_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT Security
JWT_SECRET=ethio_recruitment_user_jwt_secret_key_32bytes_min!
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=ethio_recruitment_admin_jwt_secret_key_32bytes_min!
ADMIN_JWT_EXPIRES_IN=8h

# AWS S3 Storage & CloudFront CDN
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=recruitment-agency-media
AWS_CLOUDFRONT_URL=https://d1234abcd.cloudfront.net

# Firebase Admin SDK
FIREBASE_PROJECT_ID=mock-firebase-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mock-project.iam.gserviceaccount.com

# Africa's Talking SMS API
AT_API_KEY=mock_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=AGENCY

# Security & Limits
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
