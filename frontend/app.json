{
    "expo": {
        "name": "EthioRecruit",
        "slug": "ethio-recruit",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "dark",
        "scheme": "ethiorecruit",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#0A192F"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.ethiorecruit.app"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#0A192F"
            },
            "package": "com.ethiorecruit.app"
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-font"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}